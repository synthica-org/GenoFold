\@writefile{lot}{\contentsline {table}{\numberline {III}{\ignorespaces Native-resolution comparison at 5~kb on a 10~Mb window of GM12878 chromosome~22 (chr22:20--30~Mb, 1{,}964 bins), scored by dSCC over the same bins. Best global mean in bold. $^{\ast }$: FLAMINGO from its published R package (mean\,$\pm $\,std over 3 seeds); other methods are single representative runs. At native resolution FLAMINGO's global dSCC rises from 0.27{} (50~kb, Table~\ref {tab:benchmark}) to 0.65{}.}}{5}{}\protected@file@percent }
\newlabel{tab:5kb}{{III}{5}{}{table.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {IV}{\ignorespaces Validation against \emph  {measured} single-molecule distances: Spearman correlation between reconstructed pairwise distances and the median FISH distance matrix of Bintu et al.~\cite  {bintu2018} over all 65{}-segment pairs of chromosome~21 (hg19 chr21:29.37--31.32~Mb) in two cell lines. GenoFold is mean\,$\pm $\,std over 3 seeds; best reconstruction per cell in bold. $^{\dagger }$Raw Hi-C = input contacts as distances, no reconstruction: the ceiling a faithful method inherits.}}{5}{}\protected@file@percent }
\newlabel{tab:fish}{{IV}{5}{}{table.4}{}}
